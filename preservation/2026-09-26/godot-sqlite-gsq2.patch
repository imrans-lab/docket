+/* -- query_read_only (Docket patch) ------------------------------------------
+ *
+ * Runs exactly one statement that SQLite prepares as read-only, on this
+ * connection, under an authorizer that allows reading and nothing else. The
+ * authorizer is installed before anything is prepared and stays until the
+ * statement is finalized, so it also covers a reprepare during sqlite3_step.
+ * The statement that is classified is the one that is executed. */
+
+int SQLite::read_only_authorizer(void *p_user_data, int p_action, const char *p_arg1, const char *p_arg2, const char *p_database, const char *p_trigger) {
+	switch (p_action) {
+		case SQLITE_SELECT:
+		case SQLITE_READ:
+		case SQLITE_RECURSIVE:
+			return SQLITE_OK;
+		case SQLITE_FUNCTION:
+			/* p_arg2 is the function's name. */
+			return (p_arg2 != nullptr && sqlite3_stricmp(p_arg2, "load_extension") == 0) ? SQLITE_DENY : SQLITE_OK;
+		case SQLITE_PRAGMA:
+			/* p_arg1 is the pragma's name: only these two schema reads. */
+			return (p_arg1 != nullptr && (sqlite3_stricmp(p_arg1, "table_info") == 0 || sqlite3_stricmp(p_arg1, "foreign_key_list") == 0)) ? SQLITE_OK : SQLITE_DENY;
+		default:
+			return SQLITE_DENY;
+	}
+}
+
+bool SQLite::read_only_failure(const String &p_message) {
+	error_message = p_message;
+	return false;
+}
+
+bool SQLite::query_read_only(const String &p_query, Array param_bindings) {
+	query_result.clear();
+	error_message = "";
+	if (db == nullptr) {
+		return read_only_failure("the database is not open");
+	}
+	if (read_only_running) {
+		return read_only_failure("a read-only query is already running on this connection");
+	}
+	for (int64_t i = 0; i < p_query.length(); i++) {
+		if (p_query[i] == 0) {
+			return read_only_failure("the query contains a NUL character");
+		}
+	}
+	read_only_running = true;
+	sqlite3_set_authorizer(db, read_only_authorizer, nullptr);
+	const bool ok = run_read_only(p_query.utf8(), param_bindings);
+	sqlite3_set_authorizer(db, nullptr, nullptr);
+	read_only_running = false;
+	if (!ok) {
+		query_result.clear();
+	}
+	return ok;
+}
+
+bool SQLite::run_read_only(const CharString &p_query, const Array &p_param_bindings) {
+	sqlite3_stmt *stmt = nullptr;
+	const char *tail = nullptr;
+	int rc = sqlite3_prepare_v2(db, p_query.get_data(), -1, &stmt, &tail);
+	if (rc != SQLITE_OK) {
+		sqlite3_finalize(stmt);
+		return read_only_failure(String::utf8(sqlite3_errmsg(db)));
+	}
+	if (stmt == nullptr) {
+		return read_only_failure("the query has no statement");
+	}
+
+	/* Whatever follows may only be whitespace, comments and empty statements,
+	 * which prepare to no statement. Checked before anything is stepped. */
+	while (tail != nullptr && *tail != '\0') {
+		sqlite3_stmt *next = nullptr;
+		const char *rest = nullptr;
+		rc = sqlite3_prepare_v2(db, tail, -1, &next, &rest);
+		if (rc != SQLITE_OK || next != nullptr) {
+			const String message = rc != SQLITE_OK ? String::utf8(sqlite3_errmsg(db)) : String("the query has more than one statement");
+			sqlite3_finalize(next);
+			sqlite3_finalize(stmt);
+			return read_only_failure(message);
+		}
+		if (rest == tail) {
+			break;
+		}
+		tail = rest;
+	}
+
+	if (sqlite3_stmt_readonly(stmt) == 0) {
+		sqlite3_finalize(stmt);
+		return read_only_failure("the query would change the database");
+	}
+
+	const int parameter_count = sqlite3_bind_parameter_count(stmt);
+	if (p_param_bindings.size() != parameter_count) {
+		sqlite3_finalize(stmt);
+		return read_only_failure("the query takes " + String::num_int64(parameter_count) + " bindings, " + String::num_int64(p_param_bindings.size()) + " were given");
+	}
+	for (int i = 0; i < parameter_count; i++) {
+		const Variant value = p_param_bindings[i];
+		switch (value.get_type()) {
+			case Variant::NIL:
+				rc = sqlite3_bind_null(stmt, i + 1);
+				break;
+			case Variant::BOOL:
+			case Variant::INT:
+				rc = sqlite3_bind_int64(stmt, i + 1, int64_t(value));
+				break;
+			case Variant::FLOAT:
+				rc = sqlite3_bind_double(stmt, i + 1, value);
+				break;
+			case Variant::STRING:
+			case Variant::STRING_NAME: {
+				const CharString text = (value.operator String()).utf8();
+				rc = sqlite3_bind_text(stmt, i + 1, text.get_data(), text.length(), SQLITE_TRANSIENT);
+				break;
+			}
+			case Variant::PACKED_BYTE_ARRAY: {
+				const PackedByteArray bytes = value;
+				rc = bytes.is_empty() ? sqlite3_bind_null(stmt, i + 1) : sqlite3_bind_blob64(stmt, i + 1, bytes.ptr(), bytes.size(), SQLITE_TRANSIENT);
+				break;
+			}
+			default:
+				sqlite3_finalize(stmt);
+				return read_only_failure("binding " + String::num_int64(i + 1) + " has a type that cannot be bound");
+		}
+		if (rc != SQLITE_OK) {
+			const String message = String::utf8(sqlite3_errmsg(db));
+			sqlite3_finalize(stmt);
+			return read_only_failure(message);
+		}
+	}
+
+	const int column_count = sqlite3_column_count(stmt);
+	while ((rc = sqlite3_step(stmt)) == SQLITE_ROW) {
+		Dictionary row;
+		for (int i = 0; i < column_count; i++) {
+			Variant column_value;
+			switch (sqlite3_column_type(stmt, i)) {
+				case SQLITE_INTEGER:
+					column_value = (int64_t)sqlite3_column_int64(stmt, i);
+					break;
+				case SQLITE_FLOAT:
+					column_value = sqlite3_column_double(stmt, i);
+					break;
+				case SQLITE_TEXT:
+					column_value = String::utf8((const char *)sqlite3_column_text(stmt, i));
+					break;
+				case SQLITE_BLOB: {
+					PackedByteArray bytes;
+					bytes.resize(sqlite3_column_bytes(stmt, i));
+					if (bytes.size() > 0) {
+						memcpy(bytes.ptrw(), sqlite3_column_blob(stmt, i), bytes.size());
+					}
+					column_value = bytes;
+					break;
+				}
+				default:
+					break;
+			}
+			row[StringName(String::utf8(sqlite3_column_name(stmt, i)))] = column_value;
+		}
+		query_result.append(row);
+	}
+	if (rc != SQLITE_DONE) {
+		const String message = String::utf8(sqlite3_errmsg(db));
+		sqlite3_finalize(stmt);
+		return read_only_failure(message);
+	}
+	rc = sqlite3_finalize(stmt);
+	if (rc != SQLITE_OK) {
+		return read_only_failure(String::utf8(sqlite3_errmsg(db)));
+	}
+	return true;
+}
