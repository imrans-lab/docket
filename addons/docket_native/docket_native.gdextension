[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://addons/docket_native/bin/docket_native.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/docket_native/bin/docket_native.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://addons/docket_native/bin/docket_native.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/docket_native/bin/docket_native.linux.template_release.arm64.so"
macos.debug = "res://addons/docket_native/bin/docket_native.macos.template_debug.universal.dylib"
macos.release = "res://addons/docket_native/bin/docket_native.macos.template_release.universal.dylib"
windows.debug.x86_64 = "res://addons/docket_native/bin/docket_native.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/docket_native/bin/docket_native.windows.template_release.x86_64.dll"
