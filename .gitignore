# -- FCIB: no checked-in binaries ---------------------------------------------
# Nothing that executes may be committed. Compiled artifacts are built from
# vendored source in third_party/ (see docs/BUILDING.md). Source assets such as
# icon.png are not build outputs and are tracked normally.
*.so
*.dylib
*.dll
*.wasm
*.a
*.lib
*.o
*.obj
*.exe
*.pdb
*.framework/
*.xcframework/

# GDExtension build output
addons/godot-sqlite/bin/

# SCons build state
.sconsign.dblite
third_party/**/*.os

# -- Godot ---------------------------------------------------------------------
# .godot/ is the local import cache and editor state — regenerated by
# `godot --import`, never shared.
.godot/
/build/
/dist/
export_presets_local.cfg
*.translation

# Godot 3 legacy import dir, harmless to guard against
.import/

# -- Docket data ---------------------------------------------------------------
# Work-item databases are user data, never repo content. The vault salt and
# encrypted secrets live in these files — they must not be published.
*.dct
*.dct.cache
*.dct.cache-shm
*.dct.cache-wal
*.dct-shm
*.dct-wal
*.dct.lock
*.dct.tmp.*
# Vault access audit sidecar — local forensic record, never shared
*.dct.audit.jsonl

# -- Signing / release secrets -------------------------------------------------
*.p12
*.pfx
*.pem
*.p8
*.asc
!docs/*.asc
secrets/

# -- Merge and patch leftovers -------------------------------------------------
# `git merge` and `patch` drop these next to the file they failed on. A stray
# docket.dct.orig is especially confusing given Docket refuses files containing
# conflict markers.
*.orig
*.rej
*.bak
*.patch.tmp

# -- Editors and IDEs ----------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
.vs/
*.sublime-project
*.sublime-workspace
*.code-workspace
.kate-swp
.nvimlog
*.swp
*.swo
*.swn
*~
\#*\#
.\#*
tags
.ccls-cache/
.cache/
compile_commands.json

# -- Python (mcp/ fallback server) ---------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# -- Environment ---------------------------------------------------------------
.env
.env.local
.direnv/

# -- OS noise ------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Linux
.directory
.fuse_hidden*
.nfs*
